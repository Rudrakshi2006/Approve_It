# Public base URL of EkLink deployment (given by EkLink team). No trailing slash. Server only.
EKLINK_URL=

# Must equal the token `iss` claim exactly (normally identical to EKLINK_URL). Server only.
EKLINK_ISSUER=

# EkLink Client ID (given once by EkLink admin). Server only.
EKLINK_CLIENT_ID=

# EkLink Client Secret (given once by EkLink admin; never prefix with NEXT_PUBLIC_). Server only.
EKLINK_CLIENT_SECRET=

# Callback URL registered in EkLink (must match registry exactly). Server only.
# Local dev hint: http://localhost:3002/auth/callback
EKLINK_REDIRECT_URI=

# This app's public base URL (used to build server redirects; never trust Host header). Server only.
# Local dev hint: http://localhost:3002
APP_URL=

# Session signing secret (minimum 32 bytes; generate with `openssl rand -base64 48`). Server only.
APP_SESSION_SECRET=

# Supabase project URL. Server only.
SUPABASE_URL=

# Supabase secret service-role key (never expose to browser). Server only.
SUPABASE_SECRET_KEY=

# --- EkLink sync (SYNC_CONTRACT.md section 9) -- optional ---
# Pull/push sync uses EKLINK_URL, EKLINK_ISSUER, EKLINK_CLIENT_ID, EKLINK_CLIENT_SECRET above.
# Set to false to disable the scheduler and "Sync now" (default: true when the EkLink settings are set).
EKLINK_SYNC_ENABLED=
# Minutes between pulls of /api/sync/changes (default 15).
EKLINK_SYNC_INTERVAL_MINUTES=
# Daily full snapshot reconcile, server local time HH:MM (default 02:00).
EKLINK_SYNC_FULL_AT=
